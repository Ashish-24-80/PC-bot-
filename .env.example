# Wexxy PC Bot Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit your .env file containing real tokens to GitHub.

# Telegram Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# Remote Touchpad & Streaming Settings
CLOUDFLARED_PATH=C:\path\to\cloudflared.exe
FLASK_PORT=58392
STREAM_FPS=10
STREAM_QUALITY=85

