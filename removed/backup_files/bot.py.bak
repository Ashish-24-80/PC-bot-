import logging
from telegram.ext import Application, MessageHandler, filters
from plugins import load_plugins
from middleware import admin_only
from keyboard import build_keyboard
from config import TOKEN

# Setup logging for Windows Service execution
logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
    handlers=[
        logging.FileHandler("bot.log", encoding="utf-8"),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

async def start(update, context):
    logger.info("Start command received")
    await update.message.reply_text(
        "Wexxy PC Bot is up.",
        reply_markup=build_keyboard()
    )

def main():
    logger.info("Initializing bot...")
    app = Application.builder().token(TOKEN).build()
    plugins = load_plugins()
    logger.info(f"Loaded {len(plugins)} plugins.")

    for plugin in plugins:
        # We wrap the handler with admin_only to restrict access
        app.add_handler(MessageHandler(
            filters.Text([plugin["name"]]),
            admin_only(plugin["handler"])
        ))

    # Explicit /start command handler
    app.add_handler(MessageHandler(filters.Text(["/start"]), admin_only(start)))
    
    logger.info("Starting polling...")
    app.run_polling()

if __name__ == "__main__":
    main()
